# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# cloudflare worker 本地密钥（vite-plugin-cloudflare 读取 .dev.vars）；.dev.vars.example 仍纳入版本管理
.dev.vars

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# local assistant/editor state (may contain credentials and command history)
/.claude/
/.cache/
/.vite/
/tmp/

# generated datasets and local research caches
/scripts/cache/
/scripts/out/
/public/siku/books/
/public/siku/quotable-all/
/public/worldlit/books/

# local build/typecheck artefacts and visual diagnostics
*.tsbuildinfo
/shot-*.png
/english-compass-proof.png
/enscan-tmp.mjs
/shot-tmp.mjs
